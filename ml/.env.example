# ──────────────────────────────────────────────────────────────
#  ML Service Environment Variables
#  Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────

# LLM API Configuration
# Provider: "groq" (free, fastest), "openai", "gemini", "claude"
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=https://api.groq.com/openai/v1

# Translation
# Options: "googletrans" (free, unofficial), "google_cloud"
TRANSLATION_PROVIDER=googletrans

# Embedding Model (change only if you know what you're doing)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Duplicate Detection Thresholds (tune based on your test results)
COSINE_THRESHOLD=0.82
GEO_RADIUS_KM=0.5
TIME_WINDOW_DAYS=7
COMPOSITE_THRESHOLD=0.70

# Server
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8001
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
